# Composer dependencies - reproducible via "composer install --dev",
# not part of the module's own source code. composer.json's only
# dependency is phpunit (require-dev, for running this module's own
# test suite), so vendor/ has nothing a consumer of the module needs.
/vendor/

# PHPUnit's own result cache, used to speed up repeated local test runs -
# regenerated automatically, not something to track.
/.phpunit.result.cache
/.phpunit.cache/

# IDE and editor metadata
/.idea/
/.vscode/
*.sublime-project
*.sublime-workspace

# OS-generated files
.DS_Store
Thumbs.db

# Log files
*.log

# Local environment overrides, if ever added
.env
.env.local
